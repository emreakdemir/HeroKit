{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [{ "src": "../HeroKit", "files": ["HeroKit.csproj"] }],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", "obj/**"] }
    ],
    "resource": [{ "files": ["images/**", "CNAME"] }],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "HeroKit",
      "_appTitle": "HeroKit",
      "_appFooter": "HeroKit · MIT License · <a href=\"https://github.com/emreakdemir/HeroKit\">GitHub</a>",
      "_enableSearch": true,
      "_gitContribute": { "repo": "https://github.com/emreakdemir/HeroKit", "branch": "master" }
    }
  }
}
